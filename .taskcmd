.note To use these task definitions, install `task-commander` by running:
      `cargo install task-commander`

.vars
  .RUST_TOOLCHAIN +stable

.tasks

  .build
    .desc Builds in debug mode
    .cmd cargo {{RUST_TOOLCHAIN}} build --workspace

  .clean
    .desc Cleans all targets
    .cmd cargo {{RUST_TOOLCHAIN}} clean

  .clippy
    .desc Runs clippy for all targets
    .cmd cargo {{RUST_TOOLCHAIN}} clippy --workspace --all-targets

  .cov
    .desc Generates code coverage report in text format
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov clean
    .cmd cargo {{RUST_TOOLCHAIN}} llvm-cov --no-cfg-coverage --workspace

  .fmt
    .desc Runs the code formatter
    .cmd cargo {{RUST_TOOLCHAIN}} fmt --all

  .test
    .desc Runs tests in debug mode
    .cmd cargo {{RUST_TOOLCHAIN}} test --workspace

  .testn
    .desc Runs tests in debug mode using nextest
    .cmd cargo {{RUST_TOOLCHAIN}} nextest run --workspace
